    var _arr_order: List[OrderValues]
    var _arr_person: List[PersonValues]
    var _arr_book: List[BookValues]
    var _root: Optional[UInt64]
    def __init__(out self):
        self._arr_region = List[RegionValues]()
        self._arr_order = List[OrderValues]()
        self._arr_person = List[PersonValues]()
        self._arr_book = List[BookValues]()
        self._root = None
    def new_region[o: Origin[mut=False], //](ref [o] self, var code: String = String(""), var note: String = String(""), var version: Int32 = Int32(0)) -> Region[o]:
        var up = Pointer[GraphRegularGraphArena, MutAnyOrigin](unsafe_from_address=Int(Pointer(to=self)))
        var idx = len(self._arr_region)
        up[]._arr_region.append(RegionValues(code=Optional(code^), note=Optional(note^), version=Optional(version)))
        return Region[o](Pointer(to=self), _pack(0, idx))
    def new_order[o: Origin[mut=False], //](ref [o] self, var sku: String = String(""), var qty: Int32 = Int32(0)) -> Order[o]:
        var up = Pointer[GraphRegularGraphArena, MutAnyOrigin](unsafe_from_address=Int(Pointer(to=self)))
        var idx = len(self._arr_order)
        up[]._arr_order.append(OrderValues(sku=Optional(sku^), qty=Optional(qty), region=None))
        return Order[o](Pointer(to=self), _pack(0, idx))
    def new_person[o: Origin[mut=False], //](ref [o] self, var name: String = String("")) -> Person[o]:
        var up = Pointer[GraphRegularGraphArena, MutAnyOrigin](unsafe_from_address=Int(Pointer(to=self)))
        var idx = len(self._arr_person)
        up[]._arr_person.append(PersonValues(name=Optional(name^), next=None))
        return Person[o](Pointer(to=self), _pack(0, idx))
    def new_book[o: Origin[mut=False], //](ref [o] self) -> Book[o]:
        var up = Pointer[GraphRegularGraphArena, MutAnyOrigin](unsafe_from_address=Int(Pointer(to=self)))
        var idx = len(self._arr_book)
        up[]._arr_book.append(BookValues(orders=List[UInt64](), people=List[UInt64]()))
        return Book[o](Pointer(to=self), _pack(0, idx))
    def root[o: Origin[mut=False], //](ref [o] self) -> Optional[Book[o]]:
        if not self._root:
            return None
        var p = self._root.value()
        return Book[o](Pointer(to=self), p)
    def set_root[o: Origin[mut=False], //](ref [o] self, h: Book[o]):
        var up = Pointer[GraphRegularGraphArena, MutAnyOrigin](unsafe_from_address=Int(Pointer(to=self)))
        up[]._root = Optional(h._packed)
