      "requirement": "MUST",
      "expect": "accept",
      "input": "0b0001000000046b656c70 00",
      "input_encoding": "hex"
    },
    {
      "id": "thrift-empty",
      "title": "Empty buffer is not a struct",
      "section": "Struct",
      "section_title": "STOP",
      "section_url": "https://github.com/apache/thrift/blob/master/doc/specs/thrift-binary-protocol.md",
