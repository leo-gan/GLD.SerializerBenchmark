      "section_title": "I32",
      "section_url": "https://github.com/apache/thrift/blob/master/doc/specs/thrift-binary-protocol.md",
      "paragraph": "Type 8 is a big-endian int32.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "08000100000007 00",
      "input_encoding": "hex"
    },
    {
      "id": "thrift-string",
      "title": "STRING field 1 = kelp",
      "section": "Field",
      "section_title": "STRING",
      "section_url": "https://github.com/apache/thrift/blob/master/doc/specs/thrift-binary-protocol.md",
