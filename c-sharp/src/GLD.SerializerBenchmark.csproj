<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>GLD.SerializerBenchmark</AssemblyName>
    <RootNamespace>GLD.SerializerBenchmark</RootNamespace>
    <Version>0.2.0</Version>
    <BondSkipCodegen>true</BondSkipCodegen>
  </PropertyGroup>

  <!--
    Serializer / support packages: floating versions within the current major
    (NuGet "N.*" = latest N.x at restore). That tracks non-breaking minor/patch
    updates automatically — same intent as Python ">=X,<X+1" ranges.
    Keep co-versioned pairs aligned (Bond, FlatSharp, FluentSerializer, MemoryPack, FsPickler).
  -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <PackageReference Include="protobuf-net" Version="2.*" />
    <PackageReference Include="LightProto" Version="1.*" />
    <PackageReference Include="Jil" Version="2.*" />
    <PackageReference Include="ServiceStack.Text" Version="6.*" />
    <PackageReference Include="Bond.Core.CSharp" Version="9.*" />
    <PackageReference Include="Bond.Runtime.CSharp" Version="9.*" />
    <PackageReference Include="FsPickler" Version="5.*" />
    <PackageReference Include="FsPickler.Json" Version="5.*" />
    <PackageReference Include="SharpSerializer" Version="3.*" />
    <PackageReference Include="fastJSON" Version="2.*" />
    <PackageReference Include="NetJSON" Version="1.*" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="6.*" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.*" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="6.*" />
    <PackageReference Include="Ceras" Version="4.*" />
    <PackageReference Include="CsvHelper" Version="33.*" />
    <PackageReference Include="ExtendedXmlSerializer" Version="3.*" />
    <!-- FlatSharp runtime latest is 7.5.x; pin pair so Compiler does not float to 7.9 alone -->
    <PackageReference Include="FlatSharp" Version="7.5.*" />
    <PackageReference Include="FlatSharp.Compiler" Version="7.5.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Google.Protobuf" Version="3.*" />
    <PackageReference Include="Apache.Avro" Version="1.*" />
    <PackageReference Include="GroBuf" Version="1.*" />
    <!-- 0.x: float only within the current minor (0.12.*) -->
    <PackageReference Include="Hyperion" Version="0.12.*" />
    <PackageReference Include="NetSerializer" Version="4.*" />
    <PackageReference Include="SharpYaml" Version="3.*" />
    <PackageReference Include="SpanJson" Version="4.*" />
    <PackageReference Include="Utf8Json" Version="1.*" />
    <PackageReference Include="YamlDotNet" Version="17.*" />
    <PackageReference Include="YAXLib" Version="4.*" />
    <PackageReference Include="ZeroFormatter" Version="1.*" />
    <PackageReference Include="BinaryPack" Version="1.*" />
    <PackageReference Include="MessagePack" Version="2.*" />
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="MemoryPack.Generator" Version="1.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Migrant" Version="0.13.*" />
  </ItemGroup>
</Project>
