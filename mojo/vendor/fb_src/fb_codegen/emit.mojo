from std.collections import List

from fb_codegen.names import enum_names, last_part, mojo_ident, type_names
from fb_schema.model import (
    BT_ARRAY,
    BT_BOOL,
    BT_BYTE,
    BT_DOUBLE,
    BT_FLOAT,
    BT_INT,
    BT_LONG,
    BT_OBJ,
    BT_SHORT,
    BT_STRING,
    BT_UBYTE,
    BT_UINT,
    BT_ULONG,
    BT_UNION,
    BT_USHORT,
    BT_UTYPE,
    BT_VECTOR,
    BT_VECTOR64,
    FieldDef,
    Schema,
    is_scalar,
    mojo_scalar,
    scalar_size,
)


def emit_module(schema: Schema) raises -> String:
    var objects = type_names(schema)
    var enums = enum_names(schema)
    var order = _emit_order(schema)
    var out = String()
    out += "# Generated by gld-flatc-mojo. Do not edit.\n"
    out += "from std.collections import List, Optional, Span\n"
    out += "from fb_wire.builder import Builder\n"
    out += "from fb_wire.reader import (\n"
    out += "    field_voffset,\n    indirect_field,\n"
    out += "    read_bool_field,\n"
    out += "    read_f32_field,\n"
    out += "    read_f64_field,\n"
    out += "    read_i16_field,\n"
    out += "    read_i32_field,\n"
    out += "    read_i64_field,\n"
    out += "    read_i8_field,\n"
    out += "    read_string_at,\n"
    out += "    read_string_field,\n"
    out += "    read_u16_field,\n"
    out += "    read_u32_field,\n"
    out += "    read_u64_field,\n"
    out += "    read_u8_field,\n"
    out += "    root_pos,\n"
    out += "    struct_field,\n"
    out += "    vector_elem,\n"
    out += "    vector_len,\n"
    out += "    vector_offset_at,\n"
    out += ")\n"
    out += "from fb_wire.scalar import read_bool, read_f32, read_f64, read_i16, read_i32, read_i64, read_i8, read_u16, read_u32, read_u64, read_u8\n"
    out += "from fb_wire.verify import verify_offset_vector, verify_root, verify_scalar_vector, verify_string, verify_table_header\n\n"
    for i in range(len(schema.enums)):
        out += _emit_enum(schema, enums, i)
    for k in range(len(order)):
        var oi = order[k]
        if schema.objects[oi].is_struct:
            out += _emit_struct(schema, objects, oi)
        else:
            out += _emit_table(schema, objects, enums, oi)
    return out


def _emit_order(schema: Schema) raises -> List[Int]:
    var state = List[Int]()
    var order = List[Int]()
    for _ in range(len(schema.objects)):
        state.append(0)
    for i in range(len(schema.objects)):
        _visit(schema, i, state, order)
    return order^


def _visit(schema: Schema, index: Int, mut state: List[Int], mut order: List[Int]) raises:
    if state[index] == 1:
        raise Error("cyclic table " + schema.objects[index].name)
    if state[index] == 2:
        return
    state[index] = 1
    for fi in range(len(schema.objects[index].fields)):
        var field = schema.objects[index].fields[fi].ty
        var dep = -1
        if field.base == BT_OBJ:
            dep = field.index
        elif field.base == BT_VECTOR and field.element == BT_OBJ:
            dep = field.index
        elif field.base == BT_UNION:
            _visit_union(schema, field.index, index, state, order)
        if dep >= 0 and dep != index:
            _visit(schema, dep, state, order)
    state[index] = 2
    order.append(index)


def _visit_union(schema: Schema, enum_index: Int, owner: Int, mut state: List[Int], mut order: List[Int]) raises:
    if enum_index < 0:
        return
    for vi in range(len(schema.enums[enum_index].values)):
        var dep = schema.enums[enum_index].values[vi].union_object
        if dep >= 0 and dep != owner:
            _visit(schema, dep, state, order)


def _emit_enum(schema: Schema, enums: List[String], index: Int) -> String:
    var ty = mojo_scalar(schema.enums[index].underlying)
    var out = String("struct ")
    out += enums[index]
    out += ":\n    var value: "
    out += ty
    out += "\n\n    def __init__(out self):\n        self.value = "
    out += _zero(schema.enums[index].underlying)
    out += "\n\n    def __init__(out self, value: "
    out += ty
    out += "):\n        self.value = value\n\n"
    for vi in range(len(schema.enums[index].values)):
        out += "comptime "
        out += enums[index]
        out += "_"
        out += mojo_ident(schema.enums[index].values[vi].name)
        out += ": "
        out += ty
        out += " = "
        out += _lit(schema.enums[index].underlying, schema.enums[index].values[vi].value)
        out += "\n"
    out += "\n"
    return out


def _emit_struct(schema: Schema, objects: List[String], index: Int) raises -> String:
    var name = objects[index]
    var out = String("struct ")
    out += name
    out += ":\n"
    for fi in range(len(schema.objects[index].fields)):
        out += "    var "
        out += mojo_ident(schema.objects[index].fields[fi].name)
        out += ": "
        out += _owned_type(schema, objects, schema.objects[index].fields[fi])
        out += "\n"
    out += "\n    def __init__(out self):\n"
    for fi in range(len(schema.objects[index].fields)):
        out += "        self."
        out += mojo_ident(schema.objects[index].fields[fi].name)
        out += " = "
        out += _zero_expr(schema, objects, schema.objects[index].fields[fi])
        out += "\n"
    out += "\ndef place_"
    out += name
    out += "(mut b: Builder, value: "
    out += name
    out += "):\n"
    var fi = len(schema.objects[index].fields) - 1
    while fi >= 0:
        out += "    b.pad("
        out += String(schema.objects[index].fields[fi].padding)
        out += ")\n"
        out += _place_field(schema, objects, "value.", schema.objects[index].fields[fi])
        fi -= 1
    out += "\ndef create_"
    out += name
    out += "(mut b: Builder, value: "
    out += name
    out += ") raises -> Int:\n    b.prep("
    out += String(schema.objects[index].minalign)
    out += ", "
    out += String(schema.objects[index].bytesize)
    out += ")\n    place_"
    out += name
    out += "(b, value)\n    return b.offset()\n\ndef read_"
    out += name
    out += "[origin: ImmOrigin](data: Span[Byte, origin], pos: Int) raises -> "
    out += name
    out += ":\n    var out = "
    out += name
    out += "()\n"
    for i in range(len(schema.objects[index].fields)):
        var fname = mojo_ident(schema.objects[index].fields[i].name)
        out += "    out."
        out += fname
        out += " = "
        out += _read_at(schema, objects, schema.objects[index].fields[i], "pos + " + String(schema.objects[index].fields[i].offset))
        out += "\n"
    out += "    return out^\n\n"
    return out


def _emit_table(schema: Schema, objects: List[String], enums: List[String], index: Int) raises -> String:
    var name = objects[index]
    var out = String("struct ")
    out += name
    out += ":\n"
    var nslots = 0
    for fi in range(len(schema.objects[index].fields)):
        if schema.objects[index].fields[fi].id + 1 > nslots:
            nslots = schema.objects[index].fields[fi].id + 1
        if schema.objects[index].fields[fi].deprecated or schema.objects[index].fields[fi].ty.base == BT_UNION:
            if schema.objects[index].fields[fi].ty.base == BT_UNION:
                out += _union_members(schema, objects, schema.objects[index].fields[fi])
            continue
        var fname = mojo_ident(schema.objects[index].fields[fi].name)
        if schema.objects[index].fields[fi].ty.base == BT_OBJ:
            out += "    var has_"
            out += fname
            out += ": Bool\n"
        out += "    var "
        out += fname
        out += ": "
        out += _owned_type(schema, objects, schema.objects[index].fields[fi])
        out += "\n"
    out += "\n    def __init__(out self):\n"
    for fi in range(len(schema.objects[index].fields)):
        if schema.objects[index].fields[fi].deprecated:
            continue
        if schema.objects[index].fields[fi].ty.base == BT_UNION:
            out += _union_init(schema, objects, schema.objects[index].fields[fi])
            continue
        var fname = mojo_ident(schema.objects[index].fields[fi].name)
        if schema.objects[index].fields[fi].ty.base == BT_OBJ:
            out += "        self.has_"
            out += fname
            out += " = False\n"
        out += "        self."
        out += fname
        out += " = "
        out += _zero_expr(schema, objects, schema.objects[index].fields[fi])
        out += "\n"
    out += "\n    def pack(self, mut b: Builder) raises -> Int:\n"
    out += _pack_body(schema, objects, enums, index, nslots)
    out += "\nstruct "
    out += name
    out += "View[origin: ImmOrigin]:\n    var data: Span[Byte, Self.origin]\n    var pos: Int\n\n"
    out += "    def __init__(out self, data: Span[Byte, Self.origin], pos: Int):\n"
    out += "        self.data = data\n        self.pos = pos\n"
    for fi in range(len(schema.objects[index].fields)):
        if schema.objects[index].fields[fi].deprecated or schema.objects[index].fields[fi].ty.base == BT_UNION:
            continue
        out += _view_method(schema, objects, enums, schema.objects[index].fields[fi])
    out += "\ndef unpack_"
    out += name
    out += "[origin: ImmOrigin](data: Span[Byte, origin], pos: Int) raises -> "
    out += name
    out += ":\n    var out = "
    out += name
    out += "()\n    var view = "
    out += name
    out += "View(data, pos)\n"
    out += _unpack_body(schema, objects, enums, index)
    out += "    return out^\n\ndef encode_"
    out += name
    out += "(value: "
    out += name
    out += ") raises -> List[Byte]:\n    var b = Builder()\n    var root = value.pack(b)\n    "
    if schema.file_ident.byte_length() == 4:
        out += "b.finish(root, \""
        out += schema.file_ident
        out += "\")\n"
    else:
        out += "b.finish(root)\n"
    out += "    return b.finished_list()\n\ndef decode_"
    out += name
    out += "(data: List[Byte]) raises -> "
    out += name
    out += ":\n    return unpack_"
    out += name
    out += "(data, root_pos(data, False))\n\ndef view_"
    out += name
    out += "[origin: ImmOrigin](data: Span[Byte, origin]) raises -> "
    out += name
    out += "View[origin]:\n    return "
    out += name
    out += "View(data, root_pos(data, False))\n\ndef verify_"
    out += name
    out += "[origin: ImmOrigin](data: Span[Byte, origin], pos: Int, depth: Int) raises:\n"
    out += "    if depth > 64:\n        raise Error(\"depth\")\n    _ = verify_table_header(data, pos)\n"
    out += _verify_body(schema, objects, index)
    out += "\n"
    return out


def _pack_body(schema: Schema, objects: List[String], enums: List[String], index: Int, nslots: Int) raises -> String:
    var out = String()
    for fi in range(len(schema.objects[index].fields)):
        if schema.objects[index].fields[fi].deprecated:
            continue
        var field_base = schema.objects[index].fields[fi].ty.base
        var fname = mojo_ident(schema.objects[index].fields[fi].name)
        if field_base == BT_STRING:
            out += "        var off_"
            out += fname
            out += " = 0\n        if self."
            out += fname
            out += ".byte_length() != 0:\n            off_"
            out += fname
            out += " = b.create_string(self."
            out += fname
            out += ")\n"
        elif field_base == BT_VECTOR:
            out += _pack_vector_pre(schema, objects, schema.objects[index].fields[fi])
        elif field_base == BT_OBJ and not schema.objects[schema.objects[index].fields[fi].ty.index].is_struct:
            out += "        var off_"
            out += fname
            out += " = 0\n        if self.has_"
            out += fname
            out += ":\n            off_"
            out += fname
            out += " = self."
            out += fname
            out += ".pack(b)\n"
        elif field_base == BT_UNION:
            out += _pack_union_pre(schema, objects, enums, schema.objects[index].fields[fi])
    out += "        b.start_object("
    out += String(nslots)
    out += ")\n"
    var slot = nslots - 1
    while slot >= 0:
        var found = -1
        for fi in range(len(schema.objects[index].fields)):
            if schema.objects[index].fields[fi].id == slot:
                found = fi
        if found >= 0 and not schema.objects[index].fields[found].deprecated:
            out += _pack_slot(schema, objects, enums, schema.objects[index].fields[found])
        slot -= 1
    out += "        return b.end_object()\n"
    return out


def _pack_vector_pre(schema: Schema, objects: List[String], field: FieldDef) raises -> String:
    var fname = mojo_ident(field.name)
    var out = String("        var off_")
    out += fname
    out += " = 0\n        if len(self."
    out += fname
    out += ") != 0:\n"
    if field.ty.element == BT_OBJ:
        if schema.objects[field.ty.index].is_struct:
            out += "            _ = b.start_vector("
            out += String(schema.objects[field.ty.index].bytesize)
            out += ", len(self."
            out += fname
            out += "), "
            out += String(schema.objects[field.ty.index].minalign)
            out += ")\n            var i = len(self."
            out += fname
            out += ") - 1\n            while i >= 0:\n                _ = create_"
            out += objects[field.ty.index]
            out += "(b, self."
            out += fname
            out += "[i])\n                i -= 1\n            off_"
            out += fname
            out += " = b.end_vector()\n"
        else:
            out += "            var tmp_"
            out += fname
            out += " = List[Int]()\n            for i in range(len(self."
            out += fname
            out += ")):\n                tmp_"
            out += fname
            out += ".append(self."
            out += fname
            out += "[i].pack(b))\n            off_"
            out += fname
            out += " = b.create_offset_vector(tmp_"
            out += fname
            out += ")\n"
    elif field.ty.element == BT_STRING:
        out += "            var tmp_"
        out += fname
        out += " = List[Int]()\n            for i in range(len(self."
        out += fname
        out += ")):\n                tmp_"
        out += fname
        out += ".append(b.create_string(self."
        out += fname
        out += "[i]))\n            off_"
        out += fname
        out += " = b.create_offset_vector(tmp_"
        out += fname
        out += ")\n"
    else:
        var width = scalar_size(field.ty.element)
        out += "            _ = b.start_vector("
        out += String(width)
        out += ", len(self."
        out += fname
        out += "), "
        out += String(width)
        out += ")\n            var i = len(self."
        out += fname
        out += ") - 1\n            while i >= 0:\n                "
        out += _prepend_call(field.ty.element, "self." + fname + "[i]")
        out += "\n                i -= 1\n            off_"
        out += fname
        out += " = b.end_vector()\n"
    return out


def _pack_union_pre(schema: Schema, objects: List[String], enums: List[String], field: FieldDef) -> String:
    var fname = mojo_ident(field.name)
    var en = enums[field.ty.index]
    var out = String("        var off_")
    out += fname
    out += " = 0\n"
    for vi in range(len(schema.enums[field.ty.index].values)):
        var val = schema.enums[field.ty.index].values[vi]
        if val.union_object < 0:
            continue
        var member = objects[val.union_object]
        out += "        if self."
        out += fname
        out += "_type == "
        out += en
        out += "_"
        out += mojo_ident(val.name)
        out += ":\n            off_"
        out += fname
        out += " = self."
        out += fname
        out += "_"
        out += mojo_ident(val.name)
        out += ".pack(b)\n"
        _ = member
    return out


def _pack_slot(schema: Schema, objects: List[String], enums: List[String], field: FieldDef) raises -> String:
    var fname = mojo_ident(field.name)
    var out = String()
    if field.ty.base == BT_OBJ and schema.objects[field.ty.index].is_struct:
        out += "        if self.has_"
        out += fname
        out += ":\n            var inline_"
        out += fname
        out += " = create_"
        out += objects[field.ty.index]
        out += "(b, self."
        out += fname
        out += ")\n            b.add_struct("
        out += String(field.id)
        out += ", inline_"
        out += fname
        out += ")\n"
        return out
    if field.ty.base == BT_STRING or field.ty.base == BT_VECTOR or field.ty.base == BT_UNION or (field.ty.base == BT_OBJ and not schema.objects[field.ty.index].is_struct):
        out += "        b.add_offset("
        out += String(field.id)
        out += ", off_"
        out += fname
        out += ")\n"
        return out
    if field.optional and is_scalar(field.ty.base):
        out += "        if self."
        out += fname
        out += ":\n            "
        out += _prepend_call(field.ty.base, "self." + fname + ".value()")
        out += "\n            b.slot("
        out += String(field.id)
        out += ")\n"
        return out
    if field.ty.index >= 0 and is_scalar(field.ty.base) and field.ty.base != BT_UTYPE:
        out += "        "
        out += _add_call(field.ty.base, field.id, "self." + fname + ".value", field.default_int)
        out += "\n"
        return out
    out += "        "
    out += _add_call(field.ty.base, field.id, "self." + fname, field.default_int)
    out += "\n"
    return out


def _view_method(schema: Schema, objects: List[String], enums: List[String], field: FieldDef) raises -> String:
    var fname = mojo_ident(field.name)
    var out = String("\n    def ")
    out += fname
    if field.ty.base == BT_VECTOR:
        out += "_len"
    out += "(self) raises -> "
    out += _view_type(schema, objects, enums, field)
    out += ":\n        "
    if field.ty.base == BT_STRING:
        out += "return read_string_field(self.data, self.pos, "
        out += String(field.id)
        out += ")\n"
    elif field.ty.base == BT_OBJ:
        var child = objects[field.ty.index]
        if schema.objects[field.ty.index].is_struct:
            out += "var at = struct_field(self.data, self.pos, "
            out += String(field.id)
            out += ")\n        if at < 0:\n            return "
            out += child
            out += "()\n        return read_"
            out += child
            out += "(self.data, at)\n"
        else:
            out += "var at = indirect_field(self.data, self.pos, "
            out += String(field.id)
            out += ")\n        if at < 0:\n            raise Error(\"absent\")\n        return "
            out += child
            out += "View(self.data, at)\n"
    elif is_scalar(field.ty.base):
        var reader = _field_reader(field.ty.base)
        var default = _lit(field.ty.base, field.default_int)
        if field.optional:
            out += "var off = field_voffset(self.data, self.pos, "
            out += String(field.id)
            out += ")\n        if off == 0:\n            return None\n        return Optional("
            out += _read_scalar_at(field.ty.base, "self.pos + off", "self.data")
            out += ")\n"
        elif field.ty.index >= 0 and field.ty.base != BT_UTYPE:
            out += "return "
            out += enums[field.ty.index]
            out += "("
            out += reader
            out += "(self.data, self.pos, "
            out += String(field.id)
            out += ", "
            out += default
            out += "))\n"
        else:
            out += "return "
            out += reader
            out += "(self.data, self.pos, "
            out += String(field.id)
            out += ", "
            out += default
            out += ")\n"
    elif field.ty.base == BT_VECTOR:
        out += "var at = indirect_field(self.data, self.pos, "
        out += String(field.id)
        out += ")\n        if at < 0:\n            return 0\n        return vector_len(self.data, at)\n"
    else:
        out += "raise Error(\"unsupported\")\n"
    return out


def _unpack_body(schema: Schema, objects: List[String], enums: List[String], index: Int) -> String:
    var out = String()
    for fi in range(len(schema.objects[index].fields)):
        var field = schema.objects[index].fields[fi]
        if field.deprecated or field.ty.base == BT_UNION or field.ty.base == BT_VECTOR:
            continue
        var fname = mojo_ident(field.name)
        if field.ty.base == BT_OBJ:
            var child = objects[field.ty.index]
            if schema.objects[field.ty.index].is_struct:
                out += "    var at_"
                out += fname
                out += " = struct_field(data, pos, "
                out += String(field.id)
                out += ")\n    if at_"
                out += fname
                out += " >= 0:\n        out.has_"
                out += fname
                out += " = True\n        out."
                out += fname
                out += " = read_"
                out += child
                out += "(data, at_"
                out += fname
                out += ")\n"
            else:
                out += "    var at_"
                out += fname
                out += " = indirect_field(data, pos, "
                out += String(field.id)
                out += ")\n    if at_"
                out += fname
                out += " >= 0:\n        out.has_"
                out += fname
                out += " = True\n        out."
                out += fname
                out += " = unpack_"
                out += child
                out += "(data, at_"
                out += fname
                out += ")\n"
        elif field.optional and is_scalar(field.ty.base):
            out += "    out."
            out += fname
            out += " = view."
            out += fname
            out += "()\n"
        else:
            out += "    out."
            out += fname
            out += " = view."
            out += fname
            out += "()\n"
    for fi in range(len(schema.objects[index].fields)):
        var field = schema.objects[index].fields[fi]
        if field.ty.base == BT_VECTOR and not field.deprecated:
            out += _unpack_vector(schema, objects, field)
        if field.ty.base == BT_UNION and not field.deprecated:
            out += _unpack_union(schema, objects, enums, field)
    return out


def _unpack_vector(schema: Schema, objects: List[String], field: FieldDef) -> String:
    var fname = mojo_ident(field.name)
    var out = String("    var vec_")
    out += fname
    out += " = indirect_field(data, pos, "
    out += String(field.id)
    out += ")\n    if vec_"
    out += fname
    out += " >= 0:\n        var n_"
    out += fname
    out += " = vector_len(data, vec_"
    out += fname
    out += ")\n        for i in range(n_"
    out += fname
    out += "):\n"
    if field.ty.element == BT_STRING:
        out += "            var item = vector_offset_at(data, vec_"
        out += fname
        out += ", i)\n            out."
        out += fname
        out += ".append(read_string_at(data, item))\n"
    elif field.ty.element == BT_OBJ:
        if schema.objects[field.ty.index].is_struct:
            out += "            var item = vector_elem(data, vec_"
            out += fname
            out += ", i, "
            out += String(schema.objects[field.ty.index].bytesize)
            out += ")\n            out."
            out += fname
            out += ".append(read_"
            out += objects[field.ty.index]
            out += "(data, item))\n"
        else:
            out += "            var item = vector_offset_at(data, vec_"
            out += fname
            out += ", i)\n            out."
            out += fname
            out += ".append(unpack_"
            out += objects[field.ty.index]
            out += "(data, item))\n"
    else:
        out += "            var item = vector_elem(data, vec_"
        out += fname
        out += ", i, "
        out += String(scalar_size(field.ty.element))
        out += ")\n            out."
        out += fname
        out += ".append("
        out += _read_scalar_at(field.ty.element, "item")
        out += ")\n"
    return out


def _unpack_union(schema: Schema, objects: List[String], enums: List[String], field: FieldDef) -> String:
    var fname = mojo_ident(field.name)
    var en = enums[field.ty.index]
    var out = String("    out.")
    out += fname
    out += "_type = view."
    # type field is a different schema field; the view method is on that field.
    # The union value's sibling is name + "_type" only if flatc named it that way.
    # Our schema has a separate field. Find it by name.
    out += _type_field_name(schema, field)
    out += "()\n    var uat_"
    out += fname
    out += " = indirect_field(data, pos, "
    out += String(field.id)
    out += ")\n    if uat_"
    out += fname
    out += " >= 0:\n"
    for vi in range(len(schema.enums[field.ty.index].values)):
        var val = schema.enums[field.ty.index].values[vi]
        if val.union_object < 0:
            continue
        var member = mojo_ident(val.name)
        out += "        if out."
        out += fname
        out += "_type == "
        out += en
        out += "_"
        out += member
        out += ":\n            out."
        out += fname
        out += "_"
        out += member
        out += " = unpack_"
        out += objects[val.union_object]
        out += "(data, uat_"
        out += fname
        out += ")\n"
    return out


def _type_field_name(schema: Schema, field: FieldDef) -> String:
    var want = field.name + "_type"
    # The caller passes the object through field only. Search is done by the
    # generated view method name, which matches the schema field `item_type`.
    _ = schema
    return mojo_ident(want)


def _verify_body(schema: Schema, objects: List[String], index: Int) -> String:
    var out = String()
    for fi in range(len(schema.objects[index].fields)):
        var field = schema.objects[index].fields[fi]
        if field.deprecated:
            continue
        var fname = mojo_ident(field.name)
        if field.ty.base == BT_STRING or field.ty.base == BT_UNION or (field.ty.base == BT_OBJ and not schema.objects[field.ty.index].is_struct):
            out += "    var at_"
            out += fname
            out += " = indirect_field(data, pos, "
            out += String(field.id)
            out += ")\n    if at_"
            out += fname
            out += " >= 0:\n"
            if field.ty.base == BT_STRING:
                out += "        verify_string(data, at_"
                out += fname
                out += ")\n"
            elif field.ty.base == BT_OBJ:
                out += "        verify_"
                out += objects[field.ty.index]
                out += "(data, at_"
                out += fname
                out += ", depth + 1)\n"
            else:
                out += "        pass\n"
        elif field.ty.base == BT_VECTOR:
            out += "    var at_"
            out += fname
            out += " = indirect_field(data, pos, "
            out += String(field.id)
            out += ")\n    if at_"
            out += fname
            out += " >= 0:\n"
            if field.ty.element == BT_STRING or field.ty.element == BT_OBJ and not schema.objects[field.ty.index].is_struct:
                out += "        _ = verify_offset_vector(data, at_"
                out += fname
                out += ")\n"
            elif is_scalar(field.ty.element):
                out += "        _ = verify_scalar_vector(data, at_"
                out += fname
                out += ", "
                out += String(scalar_size(field.ty.element))
                out += ")\n"
            else:
                out += "        _ = verify_scalar_vector(data, at_"
                out += fname
                out += ", "
                out += String(schema.objects[field.ty.index].bytesize)
                out += ")\n"
    return out


def _union_members(schema: Schema, objects: List[String], field: FieldDef) -> String:
    var fname = mojo_ident(field.name)
    var out = String()
    for vi in range(len(schema.enums[field.ty.index].values)):
        var val = schema.enums[field.ty.index].values[vi]
        if val.union_object < 0:
            continue
        out += "    var "
        out += fname
        out += "_"
        out += mojo_ident(val.name)
        out += ": "
        out += objects[val.union_object]
        out += "\n"
    return out


def _union_init(schema: Schema, objects: List[String], field: FieldDef) -> String:
    var fname = mojo_ident(field.name)
    var out = String()
    for vi in range(len(schema.enums[field.ty.index].values)):
        var val = schema.enums[field.ty.index].values[vi]
        if val.union_object < 0:
            continue
        out += "        self."
        out += fname
        out += "_"
        out += mojo_ident(val.name)
        out += " = "
        out += objects[val.union_object]
        out += "()\n"
    return out


def _owned_type(schema: Schema, objects: List[String], field: FieldDef) raises -> String:
    if field.ty.base == BT_ARRAY or field.ty.base == BT_VECTOR64:
        raise Error("arrays and 64-bit offsets are not supported")
    if field.optional and is_scalar(field.ty.base):
        return "Optional[" + mojo_scalar(field.ty.base) + "]"
    if field.ty.base == BT_STRING:
        return "String"
    if field.ty.base == BT_VECTOR:
        return "List[" + _elem_type(schema, objects, field) + "]"
    if field.ty.base == BT_OBJ:
        return objects[field.ty.index]
    if field.ty.base == BT_UNION:
        return mojo_scalar(BT_UTYPE)
    if field.ty.index >= 0 and is_scalar(field.ty.base) and field.ty.base != BT_UTYPE:
        return _enum_name_for(schema, field.ty.index)
    return mojo_scalar(field.ty.base)


def _enum_name_for(schema: Schema, index: Int) raises -> String:
    return mojo_ident(last_part(schema.enums[index].name))


def _elem_type(schema: Schema, objects: List[String], field: FieldDef) -> String:
    if field.ty.element == BT_STRING:
        return "String"
    if field.ty.element == BT_OBJ:
        return objects[field.ty.index]
    return mojo_scalar(field.ty.element)


def _view_type(schema: Schema, objects: List[String], enums: List[String], field: FieldDef) -> String:
    if field.optional and is_scalar(field.ty.base):
        return "Optional[" + mojo_scalar(field.ty.base) + "]"
    if field.ty.base == BT_STRING:
        return "String"
    if field.ty.base == BT_OBJ and not schema.objects[field.ty.index].is_struct:
        return objects[field.ty.index] + "View[Self.origin]"
    if field.ty.base == BT_OBJ:
        return objects[field.ty.index]
    if field.ty.index >= 0 and is_scalar(field.ty.base) and field.ty.base != BT_UTYPE:
        return enums[field.ty.index]
    if field.ty.base == BT_VECTOR:
        return "Int"
    return mojo_scalar(field.ty.base)


def _zero(base: Int) -> String:
    if base == BT_BOOL:
        return "False"
    if base == BT_FLOAT:
        return "Float32(0)"
    if base == BT_DOUBLE:
        return "Float64(0)"
    return _lit(base, 0)


def _zero_expr(schema: Schema, objects: List[String], field: FieldDef) raises -> String:
    if field.optional and is_scalar(field.ty.base):
        return "None"
    if field.ty.base == BT_STRING:
        return "String()"
    if field.ty.base == BT_VECTOR:
        return "List[" + _elem_type(schema, objects, field) + "]()"
    if field.ty.base == BT_OBJ or field.ty.base == BT_UNION:
        if field.ty.base == BT_UNION:
            return "0"
        return objects[field.ty.index] + "()"
    if field.ty.index >= 0 and is_scalar(field.ty.base) and field.ty.base != BT_UTYPE:
        return _enum_name_for(schema, field.ty.index) + "(" + _lit(field.ty.base, field.default_int) + ")"
    if field.ty.base == BT_BOOL:
        if field.default_int != 0:
            return "True"
        return "False"
    if field.ty.base == BT_FLOAT or field.ty.base == BT_DOUBLE:
        return _zero(field.ty.base)
    return _lit(field.ty.base, field.default_int)


def _lit(base: Int, value: Int64) -> String:
    var ty = mojo_scalar(base)
    return ty + "(" + String(value) + ")"


def _field_reader(base: Int) -> String:
    if base == BT_BOOL:
        return "read_bool_field"
    if base == BT_BYTE:
        return "read_i8_field"
    if base == BT_UTYPE:
        return "read_u8_field"
    if base == BT_FLOAT:
        return "read_f32_field"
    if base == BT_DOUBLE:
        return "read_f64_field"
    if base == BT_SHORT:
        return "read_i16_field"
    if base == BT_INT:
        return "read_i32_field"
    if base == BT_LONG:
        return "read_i64_field"
    if scalar_size(base) == 1:
        return "read_u8_field"
    if scalar_size(base) == 2:
        return "read_u16_field"
    if scalar_size(base) == 8:
        return "read_u64_field"
    return "read_u32_field"


def _add_call(base: Int, slot: Int, expr: String, default: Int64) -> String:
    var name = "add_i32"
    if base == BT_BOOL:
        name = "add_bool"
    elif base == BT_BYTE:
        name = "add_i8"
    elif base == BT_UBYTE or base == BT_UTYPE:
        name = "add_u8"
    elif base == BT_SHORT:
        name = "add_i16"
    elif base == BT_USHORT:
        name = "add_u16"
    elif base == BT_INT:
        name = "add_i32"
    elif base == BT_UINT:
        name = "add_u32"
    elif base == BT_LONG:
        name = "add_i64"
    elif base == BT_ULONG:
        name = "add_u64"
    elif base == BT_FLOAT:
        name = "add_f32"
    elif base == BT_DOUBLE:
        name = "add_f64"
    var dflt = _lit(base, default)
    if base == BT_BOOL:
        if default != 0:
            dflt = "True"
        else:
            dflt = "False"
    if base == BT_FLOAT:
        dflt = "Float32(0)"
    if base == BT_DOUBLE:
        dflt = "Float64(0)"
    return "b." + name + "(" + String(slot) + ", " + expr + ", " + dflt + ")"


def _prepend_call(base: Int, expr: String) -> String:
    if base == BT_BOOL:
        return "b.prepend_bool(" + expr + ")"
    if base == BT_BYTE:
        return "b.prepend_i8(" + expr + ")"
    if base == BT_UTYPE:
        return "b.prepend_u8(" + expr + ")"
    if base == BT_UBYTE:
        return "b.prepend_u8(" + expr + ")"
    if base == BT_SHORT:
        return "b.prepend_i16(" + expr + ")"
    if base == BT_USHORT:
        return "b.prepend_u16(" + expr + ")"
    if base == BT_INT:
        return "b.prepend_i32(" + expr + ")"
    if base == BT_UINT:
        return "b.prepend_u32(" + expr + ")"
    if base == BT_LONG:
        return "b.prepend_i64(" + expr + ")"
    if base == BT_ULONG:
        return "b.prepend_u64(" + expr + ")"
    if base == BT_FLOAT:
        return "b.prepend_f32(" + expr + ")"
    return "b.prepend_f64(" + expr + ")"


def _place_field(schema: Schema, objects: List[String], prefix: String, field: FieldDef) -> String:
    var expr = prefix + mojo_ident(field.name)
    if field.ty.base == BT_OBJ:
        return "    place_" + objects[field.ty.index] + "(b, " + expr + ")\n"
    if field.ty.base == BT_BOOL:
        return "    if " + expr + ":\n        b.place_u8(1)\n    else:\n        b.place_u8(0)\n"
    if field.ty.index >= 0 and is_scalar(field.ty.base):
        expr += ".value"
    var place = "place_u32"
    if field.ty.base == BT_BYTE:
        place = "place_i8"
    elif field.ty.base == BT_UTYPE:
        place = "place_u8"
    elif field.ty.base == BT_UBYTE:
        place = "place_u8"
    elif field.ty.base == BT_SHORT:
        place = "place_i16"
    elif field.ty.base == BT_USHORT:
        place = "place_u16"
    elif field.ty.base == BT_INT:
        place = "place_i32"
    elif field.ty.base == BT_UINT:
        place = "place_u32"
    elif field.ty.base == BT_LONG:
        place = "place_i64"
    elif field.ty.base == BT_ULONG:
        place = "place_u64"
    elif field.ty.base == BT_FLOAT:
        place = "place_f32"
    elif field.ty.base == BT_DOUBLE:
        place = "place_f64"
    return "    b." + place + "(" + expr + ")\n"


def _read_at(schema: Schema, objects: List[String], field: FieldDef, pos_expr: String) raises -> String:
    if field.ty.base == BT_OBJ:
        return "read_" + objects[field.ty.index] + "(data, " + pos_expr + ")"
    var expr = _read_scalar_at(field.ty.base, pos_expr)
    if field.ty.index >= 0 and is_scalar(field.ty.base) and field.ty.base != BT_UTYPE:
        return _enum_name_for(schema, field.ty.index) + "(" + expr + ")"
    return expr


def _read_scalar_at(base: Int, pos_expr: String, data_expr: String = "data") -> String:
    var reader = "read_f64"
    if base == BT_BOOL:
        reader = "read_bool"
    elif base == BT_BYTE:
        reader = "read_i8"
    elif base == BT_UTYPE or base == BT_UBYTE:
        reader = "read_u8"
    elif base == BT_SHORT:
        reader = "read_i16"
    elif base == BT_USHORT:
        reader = "read_u16"
    elif base == BT_INT:
        reader = "read_i32"
    elif base == BT_UINT:
        reader = "read_u32"
    elif base == BT_LONG:
        reader = "read_i64"
    elif base == BT_ULONG:
        reader = "read_u64"
    elif base == BT_FLOAT:
        reader = "read_f32"
    return reader + "(" + data_expr + ", " + pos_expr + ")"
