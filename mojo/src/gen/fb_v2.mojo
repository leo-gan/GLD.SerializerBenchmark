    var has_batch_event: Bool
    var batch_event: BatchEvent

    def __init__(out self):
        self.kind = FixtureKind(Int8(0))
        self.has_message = False
        self.message = Message()
        self.has_document = False
        self.document = Document()
        self.has_telemetry = False
        self.telemetry = Telemetry()
        self.has_strings = False
        self.strings = Strings()
        self.has_event = False
        self.event = Event()
        self.has_batch_message = False
        self.batch_message = BatchMessage()
        self.has_batch_document = False
        self.batch_document = BatchDocument()
        self.has_batch_telemetry = False
        self.batch_telemetry = BatchTelemetry()
        self.has_batch_strings = False
        self.batch_strings = BatchStrings()
        self.has_batch_event = False
        self.batch_event = BatchEvent()

    def pack(self, mut b: Builder) raises -> Int:
        var off_message = 0
        if self.has_message:
            off_message = self.message.pack(b)
        var off_document = 0
        if self.has_document:
            off_document = self.document.pack(b)
        var off_telemetry = 0
        if self.has_telemetry:
            off_telemetry = self.telemetry.pack(b)
        var off_strings = 0
        if self.has_strings:
            off_strings = self.strings.pack(b)
        var off_event = 0
        if self.has_event:
            off_event = self.event.pack(b)
        var off_batch_message = 0
        if self.has_batch_message:
            off_batch_message = self.batch_message.pack(b)
        var off_batch_document = 0
        if self.has_batch_document:
            off_batch_document = self.batch_document.pack(b)
        var off_batch_telemetry = 0
        if self.has_batch_telemetry:
            off_batch_telemetry = self.batch_telemetry.pack(b)
        var off_batch_strings = 0
        if self.has_batch_strings:
            off_batch_strings = self.batch_strings.pack(b)
        var off_batch_event = 0
        if self.has_batch_event:
            off_batch_event = self.batch_event.pack(b)
        b.start_object(11)
        b.add_offset(10, off_batch_event)
        b.add_offset(9, off_batch_strings)
        b.add_offset(8, off_batch_telemetry)
        b.add_offset(7, off_batch_document)
        b.add_offset(6, off_batch_message)
        b.add_offset(5, off_event)
        b.add_offset(4, off_strings)
        b.add_offset(3, off_telemetry)
        b.add_offset(2, off_document)
        b.add_offset(1, off_message)
        b.add_i8(0, self.kind.value, Int8(0))
        return b.end_object()

