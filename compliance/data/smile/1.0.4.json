{
  "format": "smile",
  "standard": "Smile 1.0.4",
  "version": "1.0.4",
  "standard_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md",
  "provenance": "original-work",
  "notes": "1.0.4 clarifications: 0x24/0x28 numbers, 0xFF end marker, reserved 0xFE, version nibble.",
  "cases": [
    {
      "id": "smile-null",
      "title": "Literal null",
      "section": "Simple literals",
      "section_title": "null",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Value token 0x21 is null. The 4-byte header 3A 29 0A 00 precedes the token.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a0021",
      "input_encoding": "hex",
      "decoded": null
    },
    {
      "id": "smile-true",
      "title": "Literal true",
      "section": "Simple literals",
      "section_title": "true",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Value token 0x23 is true.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a0023",
      "input_encoding": "hex",
      "decoded": true
    },
    {
      "id": "smile-false",
      "title": "Literal false",
      "section": "Simple literals",
      "section_title": "false",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Value token 0x22 is false.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a0022",
      "input_encoding": "hex",
      "decoded": false
    },
    {
      "id": "smile-empty-string",
      "title": "Empty string token",
      "section": "Simple literals",
      "section_title": "empty string",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Value token 0x20 is the empty string.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a0020",
      "input_encoding": "hex",
      "decoded": ""
    },
    {
      "id": "smile-small-int-7",
      "title": "Small integer 7",
      "section": "Small integers",
      "section_title": "0xC0–0xDF",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Tokens 0xC0–0xDF are zigzag small integers. zigzag(7)=14 → 0xCE.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00ce",
      "input_encoding": "hex",
      "decoded": 7
    },
    {
      "id": "smile-tiny-ascii",
      "title": "Tiny ASCII string kelp",
      "section": "Tiny ASCII",
      "section_title": "0x40–0x5F",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "0x40+(len-1) then that many ASCII bytes. kelp is 4 bytes → 0x43.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00436b656c70",
      "input_encoding": "hex",
      "decoded": "kelp"
    },
    {
      "id": "smile-empty-array",
      "title": "Empty array",
      "section": "Structure markers",
      "section_title": "START/END_ARRAY",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "0xF8 starts an array and 0xF9 ends it.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00f8f9",
      "input_encoding": "hex",
      "decoded": []
    },
    {
      "id": "smile-empty-object",
      "title": "Empty object",
      "section": "Structure markers",
      "section_title": "START/END_OBJECT",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "0xFA starts an object and 0xFB ends it.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00fafb",
      "input_encoding": "hex",
      "decoded": {}
    },
    {
      "id": "smile-int32-31",
      "title": "32-bit integer token 0x24",
      "section": "Integral numbers",
      "section_title": "0x24",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "0x24 is a zigzag VInt 32-bit integer. 31 encodes as 0x24 0xBE.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a0024be",
      "input_encoding": "hex",
      "decoded": 31
    },
    {
      "id": "smile-float32",
      "title": "32-bit float token 0x28",
      "section": "Floating point",
      "section_title": "0x28",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "0x28 is a 5-byte 7-bit-safe IEEE-754 binary32. 1.0.4/1.0.7 clarify the padding.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00280000007e03",
      "input_encoding": "hex",
      "decoded": 1.5
    },
    {
      "id": "smile-end-marker",
      "title": "0xFF after a value is end-of-content",
      "section": "Header",
      "section_title": "optional end marker",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#high-level-format",
      "paragraph": "0xFF is an optional end marker and is treated as end-of-stream, not a value.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a0021ff",
      "input_encoding": "hex",
      "decoded": null
    },
    {
      "id": "smile-reserved-fe",
      "title": "0xFE is reserved",
      "section": "Low-level format",
      "section_title": "reserved bytes",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#low-level-format",
      "paragraph": "0xFE is reserved and is not a value token.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "3a290a00fe",
      "input_encoding": "hex"
    },
    {
      "id": "smile-token-00",
      "title": "0x00 is not a value token",
      "section": "Short Shared Value",
      "section_title": "0x00 unused",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "0x00 is not used as a short shared-value token in this version.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "3a290a0000",
      "input_encoding": "hex"
    },
    {
      "id": "smile-version-nibble",
      "title": "Version nibble must be 0",
      "section": "Header",
      "section_title": "version bits",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#high-level-format",
      "paragraph": "Bits 4–7 of the flags byte are the format version. Only 0x00 is defined.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "3a290a1021",
      "input_encoding": "hex"
    },
    {
      "id": "smile-object-harbor",
      "title": "Object harbor=kelp",
      "section": "Key tokens",
      "section_title": "short ASCII names",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-key-mode",
      "paragraph": "A 6-byte field name uses key token 0x85 plus the ASCII bytes, then a tiny-ASCII value.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00fa85686172626f72436b656c70fb",
      "input_encoding": "hex",
      "decoded": {
        "harbor": "kelp"
      }
    }
  ]
}
