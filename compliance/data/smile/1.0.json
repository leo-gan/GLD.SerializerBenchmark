{
  "format": "smile",
  "standard": "Smile 1.0",
  "version": "1.0",
  "standard_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md",
  "provenance": "original-work",
  "notes": "Header + literals + tiny ASCII + containers from the 1.0 token table. Original values.",
  "cases": [
    {
      "id": "smile-null",
      "title": "Literal null",
      "section": "Simple literals",
      "section_title": "null",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Value token 0x21 is null. The 4-byte header 3A 29 0A 00 precedes the token.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a0021",
      "input_encoding": "hex",
      "decoded": null
    },
    {
      "id": "smile-true",
      "title": "Literal true",
      "section": "Simple literals",
      "section_title": "true",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Value token 0x23 is true.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a0023",
      "input_encoding": "hex",
      "decoded": true
    },
    {
      "id": "smile-false",
      "title": "Literal false",
      "section": "Simple literals",
      "section_title": "false",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Value token 0x22 is false.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a0022",
      "input_encoding": "hex",
      "decoded": false
    },
    {
      "id": "smile-empty-string",
      "title": "Empty string token",
      "section": "Simple literals",
      "section_title": "empty string",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Value token 0x20 is the empty string.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a0020",
      "input_encoding": "hex",
      "decoded": ""
    },
    {
      "id": "smile-small-int-7",
      "title": "Small integer 7",
      "section": "Small integers",
      "section_title": "0xC0–0xDF",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Tokens 0xC0–0xDF are zigzag small integers. zigzag(7)=14 → 0xCE.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00ce",
      "input_encoding": "hex",
      "decoded": 7
    },
    {
      "id": "smile-tiny-ascii",
      "title": "Tiny ASCII string kelp",
      "section": "Tiny ASCII",
      "section_title": "0x40–0x5F",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "0x40+(len-1) then that many ASCII bytes. kelp is 4 bytes → 0x43.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00436b656c70",
      "input_encoding": "hex",
      "decoded": "kelp"
    },
    {
      "id": "smile-empty-array",
      "title": "Empty array",
      "section": "Structure markers",
      "section_title": "START/END_ARRAY",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "0xF8 starts an array and 0xF9 ends it.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00f8f9",
      "input_encoding": "hex",
      "decoded": []
    },
    {
      "id": "smile-empty-object",
      "title": "Empty object",
      "section": "Structure markers",
      "section_title": "START/END_OBJECT",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "0xFA starts an object and 0xFB ends it.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00fafb",
      "input_encoding": "hex",
      "decoded": {}
    },
    {
      "id": "smile-array-two",
      "title": "Array [1, 2]",
      "section": "Structure markers",
      "section_title": "START/END_ARRAY",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Array tokens surround value tokens. zigzag(1)=2 → 0xC2; zigzag(2)=4 → 0xC4.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00f8c2c4f9",
      "input_encoding": "hex",
      "decoded": [
        1,
        2
      ]
    },
    {
      "id": "smile-object-n",
      "title": "Object n=7",
      "section": "Key tokens",
      "section_title": "short ASCII names",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-key-mode",
      "paragraph": "A one-byte field name uses key token 0x80 plus the ASCII byte, then a value token.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "3a290a00fa806ecefb",
      "input_encoding": "hex",
      "decoded": {
        "n": 7
      }
    },
    {
      "id": "smile-no-header",
      "title": "Missing smiley header",
      "section": "Header",
      "section_title": "4-byte header",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#high-level-format",
      "paragraph": "A Smile section starts with 0x3A 0x29 0x0A and a flags byte.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "21",
      "input_encoding": "hex"
    },
    {
      "id": "smile-bad-magic",
      "title": "Header is not :)\\n",
      "section": "Header",
      "section_title": "4-byte header",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#high-level-format",
      "paragraph": "Bytes 0–2 must be 0x3A 0x29 0x0A.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "3a280a0021",
      "input_encoding": "hex"
    },
    {
      "id": "smile-truncated-header",
      "title": "Truncated header",
      "section": "Header",
      "section_title": "4-byte header",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#high-level-format",
      "paragraph": "The header is four bytes.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "3a290a",
      "input_encoding": "hex"
    },
    {
      "id": "smile-empty",
      "title": "Empty buffer is not Smile",
      "section": "Header",
      "section_title": "4-byte header",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#high-level-format",
      "paragraph": "There is no empty Smile document; the header is required.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "",
      "input_encoding": "hex"
    },
    {
      "id": "smile-unclosed-array",
      "title": "Array without END_ARRAY",
      "section": "Structure markers",
      "section_title": "START/END_ARRAY",
      "section_url": "https://github.com/FasterXML/smile-format-specification/blob/master/smile-specification.md#tokens-value-mode",
      "paragraph": "Every 0xF8 must be matched by 0xF9.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "3a290a00f8",
      "input_encoding": "hex"
    }
  ]
}
