struct Telemetry:
    var source: String
    var ts: Int64
    var tags: List[String]
    var values: List[Float64]

    def __init__(out self):
        self.source = String()
        self.ts = Int64(0)
        self.tags = List[String]()
        self.values = List[Float64]()

    def pack(self, mut b: Builder) raises -> Int:
        var off_source = 0
        if self.source.byte_length() != 0:
            off_source = b.create_string(self.source)
        var off_tags = 0
        if len(self.tags) != 0:
            var tmp_tags = List[Int]()
            for i in range(len(self.tags)):
                tmp_tags.append(b.create_string(self.tags[i]))
            off_tags = b.create_offset_vector(tmp_tags)
        var off_values = 0
        if len(self.values) != 0:
            _ = b.start_vector(8, len(self.values), 8)
            var i = len(self.values) - 1
            while i >= 0:
                b.push_f64(self.values[i])
                i -= 1
            off_values = b.end_vector()
        b.start_object(4)
        b.add_offset(3, off_values)
        b.add_offset(2, off_tags)
        b.add_i64(1, self.ts, Int64(0))
        b.add_offset(0, off_source)
        return b.end_object()

