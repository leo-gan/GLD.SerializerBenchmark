# =============================================================================
# Cross-Language Serializer Benchmark — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Benchmark outputs (regenerated by runners / analysis)
# -----------------------------------------------------------------------------
logs/
logs
*.log
reports/
baseline.json
reports/baseline.json

# -----------------------------------------------------------------------------
# Editor / IDE / OS
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.idea/workspace.xml
.DS_Store
*.ntvs*
*.sln.docstates
.windsurf/
.jbeval/

# -----------------------------------------------------------------------------
# Python (python/, analysis/, root)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
pip-wheel-metadata/

# Keep intentional generated protos (python/generated/*.py is source-of-truth for runners)
# but ignore bytecode next to them
python/generated/__pycache__/
python/**/__pycache__/
analysis/**/__pycache__/

# -----------------------------------------------------------------------------
# .NET / C# (c-sharp/)
# -----------------------------------------------------------------------------
bin/
obj/
TestResults/
*.user
*.suo
*.userprefs
*.vs/
.vs/
# NuGet packages folder if restore ever dumps here (legacy packages.config keeps packages.config tracked)
c-sharp/packages/
# Local build/publish output
c-sharp/**/bin/
c-sharp/**/obj/
# Optional: do not ignore c-sharp/.nuget/NuGet.exe — required by some legacy restore scripts
# Tool/AI export dumps in Docs (keep .md/.txt; drop bulky binaries)
c-sharp/src/Docs/*.pdf
c-sharp/src/Docs/*.PDF

# Misc local data dumps
data/

# -----------------------------------------------------------------------------
# MkDocs
# -----------------------------------------------------------------------------
site/

# -----------------------------------------------------------------------------
# C harness (c/)
# -----------------------------------------------------------------------------
c/build/
c/serializer_benchmark_c
*.o
*.a
# Note: *.so / *.dylib covered under Python section; fine globally

# -----------------------------------------------------------------------------
# Rust harness (rust/)
# -----------------------------------------------------------------------------
rust/target/
rust/**/*.rs.bk

# -----------------------------------------------------------------------------
# JavaScript harness (javascript/)
# -----------------------------------------------------------------------------
javascript/node_modules/
javascript/npm-debug.log*
javascript/yarn-debug.log*
javascript/yarn-error.log*
javascript/.npm
javascript/coverage/
javascript/.nyc_output/

# -----------------------------------------------------------------------------
# Internal / scratch
# -----------------------------------------------------------------------------
.TODO.md
