{
  "name": "gld/serializer-benchmark-php",
  "description": "PHP runner for the multi-language serializer benchmark",
  "type": "project",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/leo-gan/gld-arrow-php"
    },
    {
      "type": "vcs",
      "url": "https://github.com/leo-gan/gld-ion-php"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-gmp": "*",
    "ext-json": "*",
    "ext-zlib": "*",
    "flix-tech/avro-php": "^5.1",
    "google/protobuf": "^4.29",
    "helgesverre/toon": "^3.0",
    "jms/serializer": "^3.32",
    "leo-gan/gld-arrow-php": "dev-main#463bbddfb35a140d6561e1b56386fd5ee2b283e7 as 0.2.0",
    "leo-gan/gld-ion-php": "dev-main#e199c708b093335e83b11c8ed183c333b7245bb5 as 0.2.0",
    "rybakit/msgpack": "^0.9",
    "spomky-labs/cbor-php": "^3.3.5",
    "symfony/property-access": "^7.2",
    "symfony/serializer": "^7.2",
    "symfony/yaml": "^7.2"
  },
  "autoload": {
    "psr-4": {
      "Benchmark\\": "src/",
      "Benchmark\\V2\\": "src/Generated/Benchmark/V2/",
      "GPBMetadata\\": "src/Generated/GPBMetadata/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
