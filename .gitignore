# =============================================================================
# Multi-Language Serializer Benchmark — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Benchmark outputs (regenerated by runners / analysis)
# -----------------------------------------------------------------------------
logs/
logs
*.log
reports/
baseline.json
reports/baseline.json

# -----------------------------------------------------------------------------
# Editor / IDE / OS
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.idea/workspace.xml
.DS_Store
*.ntvs*
*.sln.docstates
.windsurf/
.jbeval/

# -----------------------------------------------------------------------------
# Python (python/, analysis/, root)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv-ci/
venv/
ENV/
env/
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
pip-wheel-metadata/

# Keep intentional generated protos (python/generated/*.py is source-of-truth for runners)
# but ignore bytecode next to them
python/generated/__pycache__/
python/**/__pycache__/
analysis/**/__pycache__/

# -----------------------------------------------------------------------------
# .NET / C# (c-sharp/)
# -----------------------------------------------------------------------------
bin/
obj/
TestResults/
*.user
*.suo
*.userprefs
*.vs/
.vs/
# NuGet packages folder if restore ever dumps here
c-sharp/packages/
# Local build/publish output
c-sharp/**/bin/
c-sharp/**/obj/

# Misc local data dumps
data/
!dashboard/public/data/

# -----------------------------------------------------------------------------
# MkDocs
# -----------------------------------------------------------------------------
site/

# -----------------------------------------------------------------------------
# C harness (c/)
# -----------------------------------------------------------------------------
c/build/
c/serializer_benchmark_c
*.o
*.a
# Note: *.so / *.dylib covered under Python section; fine globally

# -----------------------------------------------------------------------------
# Rust harness (rust/)
# -----------------------------------------------------------------------------
rust/target/
rust/**/*.rs.bk

# -----------------------------------------------------------------------------
# JavaScript harness (javascript/)
# -----------------------------------------------------------------------------
javascript/node_modules/
javascript/npm-debug.log*
javascript/yarn-debug.log*
javascript/yarn-error.log*
javascript/.npm
javascript/coverage/
javascript/.nyc_output/

# -----------------------------------------------------------------------------
# Internal / scratch
# -----------------------------------------------------------------------------
.TODO.md
# Local/private planning docs (not for the public repo)
plans/

# apt downloads
*.deb

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
# Local Vite dev server files and compiled assets
dashboard/node_modules/
dashboard/dist/
docs/dashboard/

# Allow committing dashboard data files, override global ignores
!dashboard/public/data/
!dashboard/public/data/baseline.json


# C vendored deps (fetch via c/scripts/fetch-and-build-deps.sh)
c/third_party/**
!c/third_party/VERSIONS.md
c/build/
c-sharp/build_user/

# -----------------------------------------------------------------------------
# Java harness (java/)
# -----------------------------------------------------------------------------
java/target/

# -----------------------------------------------------------------------------
# Kotlin harness (kotlin/)
# -----------------------------------------------------------------------------
kotlin/build/
kotlin/.gradle/
kotlin/.kotlin/
java/.classpath
java/.project
java/.settings/

# -----------------------------------------------------------------------------
# C++ harness (cpp/)
# -----------------------------------------------------------------------------
cpp/build/
cpp/third_party/**
!cpp/third_party/VERSIONS.md

# Local scratch (protobuf debs, extracts, etc.) — never commit
.tmp/

# Swift
swift/.build/
swift/.swiftpm/
