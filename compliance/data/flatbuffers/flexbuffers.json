{
  "format": "flatbuffers",
  "standard": "FlexBuffers",
  "version": "flexbuffers",
  "standard_url": "https://flatbuffers.dev/flexbuffers.html",
  "provenance": "google/flatbuffers+original-work",
  "notes": "Official gold example (Apache-2.0) plus a full type matrix from the FlexBuffers rules.",
  "cases": [
    {
      "id": "fb-flex-gold",
      "title": "Official gold_flexbuffer_example.bin",
      "section": "FlexBuffers",
      "section_title": "example",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "Vendored official example from google/flatbuffers tests/ (Apache-2.0).",
      "requirement": "MUST",
      "expect": "accept",
      "input": "",
      "input_encoding": "hex",
      "notes": "Vendored from google/flatbuffers tests/gold_flexbuffer_example.bin (Apache-2.0)."
    },
    {
      "id": "fb-flex-int-0",
      "title": "FlexBuffers integer 0",
      "section": "FlexBuffers",
      "section_title": "Numbers",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "An integer root must decode to 0.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "000401",
      "input_encoding": "hex",
      "decoded": 0
    },
    {
      "id": "fb-flex-int-7",
      "title": "FlexBuffers integer 7",
      "section": "FlexBuffers",
      "section_title": "Numbers",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "An integer root must decode to 7.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "070401",
      "input_encoding": "hex",
      "decoded": 7
    },
    {
      "id": "fb-flex-int-neg",
      "title": "FlexBuffers integer -1",
      "section": "FlexBuffers",
      "section_title": "Numbers",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "Signed integers use two's complement.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "ff0401",
      "input_encoding": "hex",
      "decoded": -1
    },
    {
      "id": "fb-flex-int-300",
      "title": "FlexBuffers integer 300",
      "section": "FlexBuffers",
      "section_title": "Numbers",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "Values that do not fit in one byte use a wider parent.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "2c010502",
      "input_encoding": "hex",
      "decoded": 300
    },
    {
      "id": "fb-flex-true",
      "title": "FlexBuffers true",
      "section": "FlexBuffers",
      "section_title": "Booleans",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "A boolean root is a type byte plus a parent width.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "016801",
      "input_encoding": "hex",
      "decoded": true
    },
    {
      "id": "fb-flex-false",
      "title": "FlexBuffers false",
      "section": "FlexBuffers",
      "section_title": "Booleans",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "False is a distinct type, not an integer 0.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "006801",
      "input_encoding": "hex",
      "decoded": false
    },
    {
      "id": "fb-flex-float",
      "title": "FlexBuffers float 1.5",
      "section": "FlexBuffers",
      "section_title": "Numbers",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "A float root uses IEEE-754.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "0000c03f0e04",
      "input_encoding": "hex",
      "decoded": 1.5
    },
    {
      "id": "fb-flex-string",
      "title": "FlexBuffers string kelp",
      "section": "FlexBuffers",
      "section_title": "Strings",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "A string is UTF-8 bytes plus a NUL, with a length prefix.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "046b656c7000051401",
      "input_encoding": "hex",
      "decoded": "kelp"
    },
    {
      "id": "fb-flex-string-empty",
      "title": "FlexBuffers empty string",
      "section": "FlexBuffers",
      "section_title": "Strings",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "The empty string is a valid root.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "0000011401",
      "input_encoding": "hex",
      "decoded": ""
    },
    {
      "id": "fb-flex-string-harbor",
      "title": "FlexBuffers string harbor",
      "section": "FlexBuffers",
      "section_title": "Strings",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "Longer ASCII is still a string root.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "06686172626f7200071401",
      "input_encoding": "hex",
      "decoded": "harbor"
    },
    {
      "id": "fb-flex-blob",
      "title": "FlexBuffers blob kelp",
      "section": "FlexBuffers",
      "section_title": "Blobs",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "A blob is uninterpreted bytes with a length.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "046b656c70046401",
      "input_encoding": "hex",
      "decoded": {
        "$hex": "6b656c70"
      }
    },
    {
      "id": "fb-flex-vec",
      "title": "FlexBuffers vector [1,2,3]",
      "section": "FlexBuffers",
      "section_title": "Vectors",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "A typed or untyped vector stores elements then a count.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "03010203040404062801",
      "input_encoding": "hex",
      "decoded": [
        1,
        2,
        3
      ]
    },
    {
      "id": "fb-flex-vec-empty",
      "title": "FlexBuffers empty vector",
      "section": "FlexBuffers",
      "section_title": "Vectors",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "A vector may have zero elements.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "00002801",
      "input_encoding": "hex",
      "decoded": []
    },
    {
      "id": "fb-flex-map",
      "title": "FlexBuffers map harbor=kelp",
      "section": "FlexBuffers",
      "section_title": "Maps",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "A map is a vector of keys plus values.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "686172626f7200046b656c7000010e0101010a14022401",
      "input_encoding": "hex",
      "decoded": {
        "harbor": "kelp"
      }
    },
    {
      "id": "fb-flex-empty",
      "title": "Empty buffer is not a FlexBuffers root",
      "section": "FlexBuffers",
      "section_title": "Root",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "A root requires a parent width and type byte.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "",
      "input_encoding": "hex"
    },
    {
      "id": "fb-flex-truncated",
      "title": "Truncated FlexBuffers buffer",
      "section": "FlexBuffers",
      "section_title": "Root",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "The root offset must land inside the buffer.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "00",
      "input_encoding": "hex"
    },
    {
      "id": "fb-flex-short",
      "title": "Two-byte stub is not a root",
      "section": "FlexBuffers",
      "section_title": "Root",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "The trailing type and parent-width bytes must be present.",
      "requirement": "MUST NOT",
      "expect": "reject",
      "input": "0001",
      "input_encoding": "hex"
    },
    {
      "id": "fb-flex-int",
      "title": "FlexBuffers integer 7",
      "section": "FlexBuffers",
      "section_title": "Numbers",
      "section_url": "https://flatbuffers.dev/flexbuffers.html",
      "paragraph": "A FlexBuffers integer root must decode to 7.",
      "requirement": "MUST",
      "expect": "accept",
      "input": "070401",
      "input_encoding": "hex",
      "decoded": 7
    }
  ]
}
